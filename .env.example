# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# IoT Platform Database
IOT_DB_NAME=iot_platform
IOT_DB_USER=iot_user
IOT_DB_PASSWORD=changeme

# Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_INTERNAL_API_SECRET=changeme
AIRFLOW_API_SECRET=changeme
AIRFLOW_JWT_SECRET=changeme

# Mosquitto MQTT — 三個分權帳號（對應的 bcrypt hash 在 mosquitto/config/passwd，被 gitignored）
# 第一次 clone 後請依 mosquitto/config/passwd.example 內的指令 bootstrap；
# 改密碼後重跑同樣指令重產 hash（第一個帳號用 -c 建檔，其餘用 -b 追加）。
MQTT_SIMULATOR_USER=simulator
MQTT_SIMULATOR_PASSWORD=changeme
MQTT_INGESTOR_USER=ingestor
MQTT_INGESTOR_PASSWORD=changeme
MQTT_HEALTHCHECK_USER=healthcheck
MQTT_HEALTHCHECK_PASSWORD=changeme
